# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used for plans and usage counters. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (server only). Create a recurring "Pro" price and paste its id.
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Public URL of the site, used for Stripe return links (e.g. https://paperworkautopilot.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reminder emails (server only). From address must be on a domain verified in Resend.
RESEND_API_KEY=re_...
REMINDER_FROM_EMAIL=Paperwork Autopilot <reminders@yourdomain.com>
# Any long random string. Vercel Cron sends it automatically when set as a project env var.
CRON_SECRET=generate-a-long-random-string
